{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Randex",
  "version": "0.1.1",
  "identifier": "com.marlonschmitz.randex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Randex",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFMkI2ODExMjdBNzQ2MjMKUldRalJxY25FV2dyUGtpUmF6UnY4SWRPWEpkTm1lbzE3N3RIcUh6TnNtbFRwbkVCaE1HNS80S24K",
      "endpoints": [
        "https://github.com/marlon-schmitz-289/randex/releases/latest/download/latest.json"
      ]
    }
  }
}
